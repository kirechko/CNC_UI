; Программа: Круглый карман D50x20mm
; Инструмент: Фреза D3.175mm
; Стратегия: Спиральное врезание + чистовая стенка
; Глубина резания: 1.0 мм/проход

G90 G21 G17 G40 G80 G49 ; Абсолютные координаты, мм, плоскость XY
G91 G28 Z0              ; Парковка оси Z
T1 M6                   ; Смена инструмента T1
G54                     ; Рабочая система координат
S12000 M3               ; Шпиндель 12000 об/мин CW
G0 X0 Y0                ; Быстрый подвод к центру кармана
G43 H1 Z50              ; Компенсация длины, безопасная высота

; === ВРЕЗАНИЕ ПО СПИРАЛИ ===
; Центр: X0 Y0, Начальный радиус: 0, Конечный радиус: 23.4125мм
; (25 - 3.175/2 = 23.4125)
G1 Z0 F500              ; Подвод к поверхности материала
F300                    ; Подача врезания

; Проход 1: Z-1.0
G1 Z-1.0
G3 I23.4125 J0          ; Полный оборот по спирали до стенки

; Проход 2: Z-2.0
G1 Z-2.0
G3 I23.4125 J0

; Проход 3: Z-3.0
G1 Z-3.0
G3 I23.4125 J0

; Проход 4: Z-4.0
G1 Z-4.0
G3 I23.4125 J0

; Проход 5: Z-5.0
G1 Z-5.0
G3 I23.4125 J0

; Проход 6: Z-6.0
G1 Z-6.0
G3 I23.4125 J0

; Проход 7: Z-7.0
G1 Z-7.0
G3 I23.4125 J0

; Проход 8: Z-8.0
G1 Z-8.0
G3 I23.4125 J0

; Проход 9: Z-9.0
G1 Z-9.0
G3 I23.4125 J0

; Проход 10: Z-10.0
G1 Z-10.0
G3 I23.4125 J0

; Проход 11: Z-11.0
G1 Z-11.0
G3 I23.4125 J0

; Проход 12: Z-12.0
G1 Z-12.0
G3 I23.4125 J0

; Проход 13: Z-13.0
G1 Z-13.0
G3 I23.4125 J0

; Проход 14: Z-14.0
G1 Z-14.0
G3 I23.4125 J0

; Проход 15: Z-15.0
G1 Z-15.0
G3 I23.4125 J0

; Проход 16: Z-16.0
G1 Z-16.0
G3 I23.4125 J0

; Проход 17: Z-17.0
G1 Z-17.0
G3 I23.4125 J0

; Проход 18: Z-18.0
G1 Z-18.0
G3 I23.4125 J0

; Проход 19: Z-19.0
G1 Z-19.0
G3 I23.4125 J0

; Проход 20: Z-20.0 (финальная глубина)
G1 Z-20.0
G3 I23.4125 J0

; === ЧИСТОВАЯ ОБРАБОТКА СТЕНКИ ===
F800                    ; Увеличиваем подачу для чистового прохода
G1 Z-20.0               ; Убеждаемся, что мы на глубине
G3 I23.4125 J0          ; Финишный проход по стенке

; === ОТВОД ИНСТРУМЕНТА ===
G0 Z50                  ; Отвод по Z на безопасную высоту
M5                      ; Стоп шпинделя
G91 G28 Z0              ; Парковка Z
G91 G28 X0 Y0           ; Парковка X/Y
M30                     ; Конец программы
